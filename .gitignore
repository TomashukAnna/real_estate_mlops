# Data files are tracked by DVC, not Git
/data/raw/*
/data/processed/*.csv
/data/external/*.csv
!/data/raw/*.dvc
!/data/processed/*.dvc

# Model binaries are produced by pipeline
*.pkl
*.joblib
*.h5
*.pb

# Generic logs
*.log
logs/

# Runtime inference and drift artifacts
/reports/inference/
/reports/drift/

# Яндекс Диск (локальный кэш и файлы синхронизации)
.yandex_disk_cache/
.yandex_disk/
*.ydisk
.ydisk/
**/.ydisk/
**/.yandex_disk_cache/

# Данные, модели, отчеты (все, что хранится на Яндекс Диске)
/data/
/data/**/*.csv
/data/**/*.parquet
/data/**/*.feather
!/data/**/.gitkeep

# Модели
/models/
/models/**/*.pkl
/models/**/*.joblib
/models/**/*.h5
/models/**/*.pb
!/models/**/.gitkeep

# Отчеты
/reports/
/reports/**/*.json
/reports/**/*.html
/reports/**/*.csv
!/reports/**/.gitkeep

# DVC (данные версионируются отдельно)
.dvc/
.dvc_tmp/
.dvc/cache/
.dvc/remote/
*.dvc
.dvc.lock

# Временные файлы приложения
temp/
tmp/
*.tmp
*.temp

