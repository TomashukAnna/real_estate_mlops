MODEL_PATH=models/model/model.pkl
MODEL_METADATA_PATH=models/model/metadata.json
INFERENCE_LOG_PATH=reports/inference/predictions.jsonl
DRIFT_REPORT_PATH=reports/drift/latest_drift_report.json
DRIFT_HTML_PATH=reports/drift/latest_drift_report.html
DRIFT_WINDOW_SIZE=500
DRIFT_INTERVAL_SECONDS=60
DRIFT_METRICS_PORT=8001
# BFF/обучение: URI MLflow на машине-хосте. Для MLflow 3.5+ сервер на хосте
# должен быть с --allowed-hosts host.docker.internal (см. README, раздел Docker).
MLFLOW_TRACKING_URI=http://host.docker.internal:5000
BFF_DATASET_PATH=data/processed/cleaned_data.csv
# Яндекс Диск
YANDEX_DISK_TOKEN=your_yandex_disk_token_here
YANDEX_DISK_BASE_PATH=/MLOps/real_estate